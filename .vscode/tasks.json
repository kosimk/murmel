{
  // Run via Terminal → Run Task… (or Ctrl/Cmd+Shift+B for the default build).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check setup",
      "type": "shell",
      "command": "./scripts/check-setup.sh",
      "windows": { "command": "powershell -ExecutionPolicy Bypass -File scripts\\check-setup.ps1" },
      "problemMatcher": []
    },
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "windows": { "command": ".\\gradlew.bat assembleDebug" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Install on phone",
      "type": "shell",
      "command": "./gradlew installDebug && adb shell am start -n app.murmel/.MainActivity",
      "windows": { "command": ".\\gradlew.bat installDebug; adb shell am start -n app.murmel/.MainActivity" },
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "./gradlew test",
      "windows": { "command": ".\\gradlew.bat test" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Open test report",
      "type": "shell",
      "command": "xdg-open app/build/reports/tests/testDebugUnitTest/index.html",
      "osx": { "command": "open app/build/reports/tests/testDebugUnitTest/index.html" },
      "windows": { "command": "start app\\build\\reports\\tests\\testDebugUnitTest\\index.html" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Show app logs (logcat)",
      "type": "shell",
      "command": "adb logcat --pid=$(adb shell pidof -s app.murmel)",
      "windows": { "command": "adb logcat" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "List connected phones",
      "type": "shell",
      "command": "adb devices",
      "problemMatcher": []
    }
  ]
}
