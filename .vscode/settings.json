{
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true
  },
  "java.import.gradle.enabled": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[kotlin]": {
    "editor.defaultFormatter": "JetBrains.kotlin-server",
    "editor.formatOnSave": true
  }
}
